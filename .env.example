# Development: leave DJANGO_DEBUG=True and use mock_ad.xlsx.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Karachi

# Production PostgreSQL (set all values to enable PostgreSQL).
# POSTGRES_DB=ticketing
# POSTGRES_USER=ticketing_app
# POSTGRES_PASSWORD=replace-with-a-long-unique-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# Production Microsoft Entra ID SSO. Leave unset in development.
# MS_TENANT_ID=your-tenant-id
# MS_CLIENT_ID=your-app-client-id
# MS_CLIENT_SECRET=your-app-client-secret

# Production host, HTTPS and SMTP settings.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tickets.example.com
# CORS_ALLOWED_ORIGINS=https://tickets.example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=replace-with-smtp-password
# DEFAULT_FROM_EMAIL=no-reply@example.com
