# Development: leave DJANGO_DEBUG=True and use mock_ad.xlsx.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Karachi

# Production PostgreSQL (set all values to enable PostgreSQL).
# POSTGRES_DB=ticketing
# POSTGRES_USER=ticketing_app
# POSTGRES_PASSWORD=replace-with-a-long-unique-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# Production Microsoft Entra ID SSO. Leave unset in development.
# MS_TENANT_ID=your-tenant-id
# MS_CLIENT_ID=your-app-client-id
# MS_CLIENT_SECRET=your-app-client-secret

# Production host, HTTPS and SMTP settings.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tickets.example.com
# CORS_ALLOWED_ORIGINS=https://tickets.example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=no-reply@example.com
# EMAIL_HOST_PASSWORD=replace-with-smtp-password
# DEFAULT_FROM_EMAIL=no-reply@example.com

# Render / Supabase Storage (optional but recommended for persistent uploads)
# AWS_STORAGE_BUCKET_NAME=hr-ticketing
# AWS_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# AWS_ACCESS_KEY_ID=<supabase-s3-access-key>
# AWS_SECRET_ACCESS_KEY=<supabase-s3-secret-key>
# AWS_S3_REGION_NAME=ap-southeast-1
# AWS_S3_ADDRESSING_STYLE=path
# AWS_QUERYSTRING_AUTH=True

# Inbound email / Celery
# IMAP_HOST=imap.example.com
# IMAP_USER=helpdesk@example.com
# IMAP_PASSWORD=<imap-password>
# IMAP_FOLDER=INBOX
# REDIS_CACHE_URL=redis://...
# CELERY_BROKER_URL=redis://...
# CELERY_RESULT_BACKEND=redis://...
